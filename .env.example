# Gemini API Anahtarı (Google AI Studio'dan ücretsiz alınabilir: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 Kimlik Bilgileri Dosyası Yolu (Google Cloud Console'dan indirilen client_secrets.json)
YOUTUBE_CLIENT_SECRET_FILE=client_secrets.json

# Varsayılan Dil ve Ayarlar
DEFAULT_LANGUAGE=en-US
DEFAULT_VOICE=en-US-AnaNeural
VIDEO_ORIENTATION=vertical
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
FPS=30

# Otomatik İndirme ve Çıktı Klasörleri
OUTPUT_DIR=output
ASSETS_DIR=assets
